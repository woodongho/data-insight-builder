# Gemini API Key (https://aistudio.google.com/ 에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델명 (기본값: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Flask 디버그 모드 설정 (true / false)
FLASK_DEBUG=true

# 업로드 최대 용량 제한 (MB)
MAX_UPLOAD_MB=10

# 수업용 4자리 입장 비밀번호 & 세션 쿠키 서명 키
SECRET_KEY=change-this-in-production
SITE_PASSWORD=1234
